#
# What lares-share runs as its lares-awdl inside WSL (LARES_AWDL): borrows
# the USB Wi-Fi adapter from Windows for the session, runs the real
# lares-awdl on it, and gives it back when that ends (issue #98).
#
# The adapter hears only on its first start after Windows had it, and
# Windows needs a few seconds with it in between. So each session is:
# Windows has it, attach, bring up, lares-awdl starts it once, detach; and a
# session that comes right after another, or finds the adapter still
# attached, waits for Windows first.
BIN=$(dirname "$(readlink -f "$0")")
USBIPD=${LARES_USBIPD:-/mnt/c/Program Files/usbipd-win/usbipd.exe}
ID=0bda:8179
REST=5   # seconds Windows keeps the adapter between two sessions
STAMP=${HOME:-/root}/.cache/lares-gave-back   # outlives a restart of the distribution
fail() { printf '{"event":"error","message":"%s"}\n' "$1"; exit 1; }

give_back() {
  modprobe -r rtl8xxxu 2>/dev/null
  "$USBIPD" detach --hardware-id $ID </dev/null >/dev/null 2>&1
  date +%s > "$STAMP"
}

# Asked to stop while the adapter is still on its way: give it back and go.
stop=""
child=""
trap 'stop=1; [ -n "$child" ] && kill -TERM $child 2>/dev/null' TERM INT HUP
stopped() { [ -n "$stop" ] && { give_back; printf '{"event":"stopped"}\n'; exit 0; }; }

[ -f /proc/self/fd/2 ] && truncate -s 0 /proc/self/fd/2   # the log starts over each session
[ -x "$USBIPD" ] || fail "usbipd-win isn't installed on Windows, so the Wi-Fi adapter can't be lent to WSL."
lsusb | grep -q $ID && give_back
left=$(( $(cat "$STAMP" 2>/dev/null || echo 0) + REST - $(date +%s) ))
if [ $left -gt 0 ] && [ $left -le $REST ]; then
  sleep $left &
  wait $!
  stopped
fi
"$USBIPD" attach --wsl --hardware-id $ID </dev/null >/dev/null 2>&1
stopped
r=$("$BIN/bringup.sh" </dev/null)
stopped
case "$r" in
  ready*) ifname=${r#ready } ;;
  "failed no-adapter") give_back; fail "The Wi-Fi adapter didn't reach WSL. Is it plugged in, and shared with usbipd?" ;;
  *) give_back; fail "The Wi-Fi adapter didn't start in WSL." ;;
esac
modprobe tun 2>/dev/null

# The same arguments, on the interface WSL gave it.
args=()
while [ $# -gt 0 ]; do
  if [ "$1" = "--wifi" ]; then args+=(--wifi "$ifname"); shift 2; else args+=("$1"); shift; fi
done
"$BIN/lares-awdl" "${args[@]}" <&0 &   # a background job would get /dev/null otherwise
child=$!
wait $child
code=$?
[ -n "$stop" ] && wait $child   # a signal ends the first wait early
give_back
exit $code
